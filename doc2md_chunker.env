# Direct Path NO API KEY: comment out, if using NGINX. 
DOC2MD_ROOT_PATH=  # direct access — no root_path prefix
 
# Base URL of the primary LLM 
DOC2MD_LLM_MODEL_DEFAULT_BASE_URL=http://host.containers.internal:8080
DOC2MD_LLM_MODEL_CHAT_BASE_URL=http://host.containers.internal:8080
DOC2MD_LLM_MODEL_TRANSLATE_BASE_URL=http://host.containers.internal:8080
DOC2MD_LLM_MODEL_CHUNK_BASE_URL=http://host.containers.internal:8080
DOC2MD_LLM_MODEL_CLASSIFIER_BASE_URL=http://host.containers.internal:8080
DOC2MD_LLM_MODEL_TABLE_BASE_URL=http://host.containers.internal:8080
DOC2MD_LLM_MODEL_OCR_BASE_URL=http://host.containers.internal:8080
DOC2MD_LLM_MODEL_PICTURE_BASE_URL=http://host.containers.internal:8080

# Default LLM model name to use
DOC2MD_TRANSLATE_MODEL=translategemma-4b-it.f16
DOC2MD_LLM_MODEL=gemma-4-12b-it-Q4_0
DOC2MD_LLM_MODEL_CLASSIFIER=Qwen2.5-VL-3B-Instruct-Q8_0
DOC2MD_LLM_MODEL_OCR=GLM-OCR-f16
DOC2MD_LLM_MODEL_TABLE=Qwen2.5-VL-3B-Instruct-Q8_0
DOC2MD_LLM_MODEL_FIGURE=Qwen2.5-VL-3B-Instruct-Q8_0
DOC2MD_LLM_MODEL_PICTURE=Qwen2.5-VL-3B-Instruct-Q8_0



# exposed port 
DOC2MD_EXPOSED_PORT=8090

# HTTPX timeout in seconds for all HTTP clients
# Example: 300.0 = 5 minutes
DOC2MD_HTTPX_TIMEOUT=600.0

DOC2MD_LLM_CONTEXT_LENGTH=4096
DOC2MD_LLM_NUM_PREDICT=2048
DOC2MD_LLM_SAFETY_MARGIN_TOKENS=512
DOC2MD_LLM_MAX_RETRIES=2
DOC2MD_LLM_RETRY_BACKOFF_SECONDS=1.5

DOC2MD_STATIC_MODEL_ROOT=/models/huggingface
DOC2MD_SEMANTIC_CHUNKER_MODEL=minishlab/potion-base-32M
DOC2MD_SDPM_CHUNKER_MODEL=minishlab/potion-base-32M
DOC2MD_LATE_CHUNKER_MODEL=all-MiniLM-L6-v2
DOC2MD_NEURAL_CHUNKER_MODEL=mirth/chonky_modernbert_large_1

# Maximum upload size in bytes   100 * 1024 * 1024 = 104857600 bytes (100 MB)
DOC2MD_MAX_UPLOAD_BYTES=104857600
# Base directory for temporary files created by the app
# Make sure this path is writable by the app user
DOC2MD_APP_TMP_BASE=/tmp

# Whether to keep temporary files after processing
# Valid values: "true" or "false"
DOC2MD_KEEP_TMP=false

# Directory where application logs are written
# Must exist or be creatable by the app
DOC2MD_LOG_DIR=/var/log/app

# Sampling temperature for OCR-related LLM calls
# Lower values = more deterministic, higher = more creative
DOC2MD_LLM_OCR_TEMPERATURE=0.1

# Allowed CORS origins, comma-separated
DOC2MD_ALLOWED_ORIGINS=*

DOC2MD_HF_MODELS_DIR=/home/riaz/ollama/huggingface

# Allowed image file extensions (comma-separated, no spaces)
DOC2MD_IMAGE_EXTS=.png,.jpg,.jpeg,.webp,.bmp,.tiff

# Allowed document/file extensions (comma-separated, no spaces)
DOC2MD_SUPPORTED_EXTS=.pdf,.docx,.pptx,.xlsx,.txt,.md,.html,.htm,.csv,.json,.xml


# ---------------------------------------------------------------------------
# /media_to_text — Whisper transcription
# ---------------------------------------------------------------------------
# Model size: tiny | base | small | medium | large | large-v2 | large-v3
# Larger models are more accurate but require more VRAM and are slower.
#   tiny / base  → ~1 GB VRAM   (fast, good for common languages)
#   small        → ~2 GB VRAM   (balanced)
#   medium       → ~5 GB VRAM   (high accuracy)
#   large-v3     → ~10 GB VRAM  (best, all 99+ languages)
DOC2MD_WHISPER_MODEL_SIZE=base

# Comma-separated audio extensions accepted by /media_to_text
DOC2MD_AUDIO_EXTS=.mp3,.wav,.flac,.ogg,.m4a,.aac,.wma,.opus,.webm

# Comma-separated video extensions accepted by /media_to_text
# (audio is extracted automatically via ffmpeg)
DOC2MD_VIDEO_EXTS=.mp4,.mkv,.avi,.mov,.flv,.wmv,.ts,.3gp


# --------------------------------------------------------------------------
# HuggingFace / Chonkie embedding & neural models
# All resolved via _resolve_model_path() → /models/huggingface/<org>--<name>
# Pre-download with: python download_models.py
# --------------------------------------------------------------------------
DOC2MD_STATIC_MODEL_ROOT=/models/huggingface

# SemanticChunker + SDPMChunker  (model2vec static model, ~32 M params, very fast)
DOC2MD_SEMANTIC_CHUNKER_MODEL=minishlab/potion-base-32M
DOC2MD_SDPM_CHUNKER_MODEL=minishlab/potion-base-32M

# LateChunker — needs a *long-context* encoder so full-doc context is preserved.
# all-MiniLM-L6-v2 has 512-token ctx (minimum viable).
# Better choices (pre-download one of these for airgap):
#   jinaai/jina-embeddings-v2-base-en          (8 192-token ctx, ~137 M)
#   nomic-ai/nomic-embed-text-v1               (8 192-token ctx, ~137 M)
#   sentence-transformers/all-MiniLM-L6-v2     (512-token ctx, ~22 M, lightest)
DOC2MD_LATE_CHUNKER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# NeuralChunker — boundary-detection transformer
DOC2MD_NEURAL_CHUNKER_MODEL=mirth/chonky_modernbert_large_1
